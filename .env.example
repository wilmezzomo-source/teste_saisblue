# Edite este arquivo como texto e salve uma cópia .env. Sem aspas ou comandos.
# crm.saisblue.com.br é uma sugestão; configurar DNS e HTTPS antes de publicar.
APP_ENV=production
APP_URL=https://crm.saisblue.com.br
CRM_DOMAIN=crm.saisblue.com.br
CRM_DB=data/crm.sqlite3
ALLOW_SIMULATION=0
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v22.0
# Manter loopback em produção com proxy HTTPS. O assistente LAN ajusta em teste.
CRM_LISTEN_HOST=127.0.0.1
# Piloto ngrok: preencher apenas localmente; não enviar segredos no chat ou Git.
NGROK_AUTHTOKEN=
META_WEBHOOK_URL=
